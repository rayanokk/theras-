AWS_REGION=us-east-1
BEDROCK_MODEL_ID_AGENT=
BEDROCK_MODEL_ID_RISK=
GATEWAY_URL=http://localhost:8000
POLICE_DB_PATH=./police.db
RISK_LLM_ENABLED=true
# durée de vie d'une approbation, plafonnée à 600 s (10 min)
APPROVAL_TTL_SECONDS=600
# pare-feu MCP : brancher des serveurs MCP amont au démarrage (OFF par défaut)
THERAS_MCP_FIREWALL=false
AGENT_KEY_RESEARCH=dev-agent-research-key
AGENT_KEY_OPS=dev-agent-ops-key
AGENT_KEY_ASSISTANT=dev-agent-assistant-key
APPROVER_KEY_ALICE=dev-approver-alice-key
APPROVER_KEY_BOB=dev-approver-bob-key
